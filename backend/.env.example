# backend/.env.example

APP_NAME=CloudShop API
APP_DESCRIPTION=CloudShop E-Commerce API with reporting and analytics
APP_VERSION=1.0.0

# Main transactional DB
DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/cloudcom_db

# Reporting DB (analytics)
REPORTING_DATABASE_URL=postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/cloudcom_reporting_db

# Security
SECRET_KEY=CHANGE_ME_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
