# Core app config
APP_NAME=cloudcom
APP_ENV=development

# Main transactional DB
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cloudcom_db

# Reporting / analytics DB
REPORTING_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/cloudcom_reporting_db

# Security
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (adjust as needed)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
